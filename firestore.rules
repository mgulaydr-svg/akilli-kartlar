rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsExisting() { return signedIn() && resource.data.userId == request.auth.uid; }
    function ownsIncoming() { return signedIn() && request.resource.data.userId == request.auth.uid; }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
    match /decks/{deckId} {
      allow create: if ownsIncoming();
      allow read, update, delete: if ownsExisting() && ownsIncoming();
    }
    match /cards/{cardId} {
      allow create: if ownsIncoming();
      allow read, update, delete: if ownsExisting() && ownsIncoming();
    }
    match /reviews/{reviewId} {
      allow create: if ownsIncoming();
      allow read: if ownsExisting();
      allow update, delete: if false;
    }
  }
}
